# ========================================================================
#  GENERAL MODERN — переменные окружения для VPS (скопируйте в .env)
#  Значения секретов возьмите в Vercel → Project → Settings → Environment
#  Variables (или у себя). НИКОГДА не коммитьте реальный .env.
# ========================================================================

# --- Telegram: админ/канальный бот (накладные в канал) ---
TELEGRAM_BOT_TOKEN=            # токен бота от @BotFather
TELEGRAM_CHANNEL_ID=          # id/username канала для накладных (-100... или @name)
TELEGRAM_WEBHOOK_SECRET=      # любая случайная строка (защита вебхука)

# --- Telegram: клиентский бот (@generalmodernbot) ---
CLIENT_BOT_TOKEN=             # токен клиентского бота от @BotFather
CLIENT_BOT_USERNAME=generalmodernbot

# --- Уведомления владельцу ---
ADMIN_CHAT_ID=837138321       # ваш chat_id

# --- Supabase ---
SUPABASE_URL=https://ttgcrcloioznojreogwn.supabase.co
SUPABASE_SERVICE_KEY=         # service_role ключ (секрет!)

# --- Сайт / сервер ---
SITE_JWT_SECRET=              # длинная случайная строка (вход клиентов на сайте)
PUBLIC_URL=https://ВАШ_ДОМЕН  # публичный https-адрес сайта на VPS
PORT=3000
