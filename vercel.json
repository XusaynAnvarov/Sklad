{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "functions": {
    "api/bot.js":                         { "includeFiles": "api/fonts/**", "maxDuration": 30 },
    "api/telegram.js":                    { "includeFiles": "api/fonts/**", "maxDuration": 30 },
    "api/client/invoice-pdf.js":          { "includeFiles": "api/fonts/**", "maxDuration": 30 },
    "api/catalog.js":                     { "maxDuration": 15 },
    "api/client/login.js":                { "maxDuration": 15 },
    "api/client/register.js":             { "maxDuration": 15 },
    "api/client/verify-start.js":         { "maxDuration": 15 },
    "api/client/verify-status.js":        { "maxDuration": 10 },
    "api/client/me.js":                   { "maxDuration": 15 },
    "api/client/orders.js":               { "maxDuration": 15 },
    "api/client/invoices.js":             { "maxDuration": 15 },
    "api/client/payments.js":             { "maxDuration": 15 },
    "api/site-order.js":                  { "maxDuration": 20 },
    "api/admin-site/clients.js":          { "maxDuration": 20 },
    "api/admin-site/orders.js":           { "maxDuration": 20 },
    "api/admin-site/delete-client.js":    { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
